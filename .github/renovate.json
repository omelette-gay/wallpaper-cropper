{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "UpscalerJS and its models run on TensorFlow.js, so update them together",
      "matchPackageNames": ["@tensorflow/tfjs", "upscaler", "@upscalerjs/**"],
      "groupName": "AI upscaling"
    },
    {
      "matchPackageNames": ["@fontsource/**"],
      "groupName": "fonts"
    },
    {
      "matchPackageNames": ["vite", "vite-plugin-static-copy"],
      "groupName": "Vite"
    }
  ]
}
